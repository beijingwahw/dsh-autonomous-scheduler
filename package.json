{
  "name": "dsh-proactive",
  "version": "0.1.0",
  "description": "自主智能多模型协同调度系统 — 主动感知、自主决策、多模型并行、质量反思自愈、经验沉淀进化",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "patches",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "node --expose-internals --import tsx ./node_modules/@deepseek-ai/cordis/bin.js",
    "typecheck": "tsc --noEmit",
    "generate:patches": "node scripts/generate-domestic-patches.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "scheduler",
    "autonomous",
    "llm"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "^1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "tsdown": "latest",
    "tsx": "^4.23.12",
    "typescript": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
